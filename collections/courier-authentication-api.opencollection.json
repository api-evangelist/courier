{
  "opencollection": "1.0.0",
  "info": {
    "name": "Courier Audiences Authentication API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a JWT",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.courier.com/auth/issue-token",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a new access token."
        }
      ]
    }
  ],
  "bundled": true
}